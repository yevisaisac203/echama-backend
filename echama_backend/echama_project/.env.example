# Copy to .env and fill in real values. Never commit the real .env file.

SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# Origins the frontend is served from. Empty by default = no browser
# origin can call this API at all.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Error monitoring. Leave blank to disable entirely (the default).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://echama:password@localhost:5432/echama
